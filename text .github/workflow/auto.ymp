name: Daily Run

on:
  schedule:
    - cron: '0 0 * * *'  # 每天自動跑一次
  workflow_dispatch:      # 也可以讓我們隨時手動點按鈕跑

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      - run: python run.py
      - name: 儲存並更新網頁
        run: |
          git config --global user.name 'github-actions'
          git config --global user.email 'github-actions@github.com'
          git add index.html
          git commit -m "自動更新圖表" || exit 0
          git push
